"""组合代码——把 adapter 接入 Lancelot loop。

由 lancelot compose 生成。手改可读，但下次 compose 会被覆盖。
"""
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, List, Optional

GENERATED_ROOT = Path(__file__).resolve().parent
if str(GENERATED_ROOT) not in sys.path:
    sys.path.insert(0, str(GENERATED_ROOT))

import yaml

from lancelot_runtime.domain import Session
from lancelot_runtime.loop.single_loop import create_loop
from lancelot_runtime.model_default.mock import create_model
from lancelot_runtime.channel_default.stdio import create_channel
{% for adapter in adapters %}
from adapters.{{ adapter.id }} import {{ adapter.entry_factory }}
{% endfor %}


CONFIG_PATH = Path(__file__).resolve().parent / "config.yaml"


def _load_config() -> dict:
    """读固化在生成物里的 config.yaml。生成物不回头问装配器。"""
    with CONFIG_PATH.open("r", encoding="utf-8") as f:
        return yaml.safe_load(f)


@dataclass
class App:
    """生成物装配后的运行句柄：loop + session。

    `main.py` 拿到这个对象后调用 `run(app)` 启动。
    """
    loop: Any
    session: Session


def start() -> App:
    """实例化所有部件并组装 loop + session。"""
    cfg = _load_config()
    selection = {item["adapter_id"]: item for item in cfg["generation"]["selection"]}

    # 保留端口（由 Lancelot runtime 提供；adapter 不可替换）
    model = create_model()
    channel = create_channel()

    # adapter 实例化（按 manifest config_schema 套用默认值）
    memory: Any = None
    tools: List[Any] = []
    {% for adapter in adapters %}
    {% if adapter.category == "memory" %}
    _mem_cfg = selection.get("{{ adapter.id }}", {}).get("config", {})
    memory = {{ adapter.entry_factory }}()
    if hasattr(memory, "configure"):
        memory.configure(_mem_cfg)
    {% elif adapter.category == "tools" %}
    _tool_cfg = selection.get("{{ adapter.id }}", {}).get("config", {})
    _tool = {{ adapter.entry_factory }}()
    if hasattr(_tool, "configure"):
        _tool.configure(_tool_cfg)
    tools.append(_tool)
    {% endif %}
    {% endfor %}

    loop = create_loop(
        model=model,
        channel=channel,
        memory=memory,
        tools=tools,
        max_turns=cfg.get("defaults", {}).get("max_turns", 10),
    )

    session = Session(
        session_id="local",
        task_id=None,
        messages=[],
        metadata={"generated": True},
    )
    return App(loop=loop, session=session)


def run(app: App) -> None:
    """启动 loop。Ctrl+C 时由 main.py 捕获并退出。"""
    app.loop.run(app.session)
